# Copy to .env and fill in. Secrets - never commit the real .env.

# Falls back to smartlead-kit/.env if unset here.
APOLLO_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_WRITE_TOKEN=

# GitHub PR creation (per-run output commit). Token needs repo scope.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main

# Optional: pre-configure a shared Account Mapping Sheet so individual users
# don't need to upload it every run (only used if the exclusion question gets
# answered "yes"). Two ways to do this:
#   - ACCOUNT_MAPPING_SHEET_PATH pins one exact file - simple, but goes stale
#     the moment a newer copy is downloaded.
#   - ACCOUNT_MAPPING_SHEET_GLOB (default below) auto-picks whichever file
#     matching the pattern was modified most recently - matches the existing
#     "download a fresh dated copy weekly" workflow, so leaving this at its
#     default just works without ever touching this file again.
ACCOUNT_MAPPING_SHEET_PATH=
ACCOUNT_MAPPING_SHEET_GLOB=~/Downloads/Account Mapping Sheet 2026*.csv

# Optional: powers the completeness step (fills missing domain/industry/
# employee-size gaps via web search). Completeness is silently skipped if unset.
# Per-instance config - whoever runs this backend uses their own key.
ANTHROPIC_API_KEY=

# For constructing a direct HubSpot static-list URL on the "no association" import path.
HUBSPOT_PORTAL_ID=6512810
HUBSPOT_APP_SUBDOMAIN=app-na2.hubspot.com
